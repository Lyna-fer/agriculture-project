# 🔐 AgriTech Environment Variables (DO NOT COMMIT THIS FILE)
# Copy to .env and fill in your values

# Neon PostgreSQL Database
DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require

# JWT Secret (min 32 chars, change in production)
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars

# API Settings
API_HOST=127.0.0.1
API_PORT=8000
VITE_API_URL=http://127.0.0.1:8000

# Google Earth Engine (if used)
EE_PROJECT=isil-b-agri-project
